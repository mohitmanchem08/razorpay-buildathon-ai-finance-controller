# Copy this file to .env and paste your real key(s) in — never commit .env itself to GitHub

# Single key (basic setup)
GEMINI_API_KEY=your-key-here

# OR multiple keys, comma-separated, for automatic fallback if one account's
# daily quota is exhausted (Gemini's free tier is tight -- as low as 20
# requests/day on the newest model). If GEMINI_API_KEYS is set, it takes
# priority over the single GEMINI_API_KEY above.
GEMINI_API_KEYS=key-from-account-1,key-from-account-2

# Optional: only needed if you switch PROVIDER = "claude" in ai_client.py
ANTHROPIC_API_KEY=your-key-here
